{
  "name": "hunt-simulation",
  "version": "0.0.3",
  "private": true,
  "description": "《卫戍协议：狩猎模拟》：基于 sganggs/Stronghold-Protocol v0.3.1 的 2V2 狩猎模拟衍生版（Node.js 服务器 + 浏览器客户端，GPL-3.0-or-later，非商业）",
  "upstream": "0.3.1",
  "license": "GPL-3.0-or-later",
  "homepage": "https://github.com/T1113047/Stronghold-Protocol-Hunt-Simulation#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/T1113047/Stronghold-Protocol-Hunt-Simulation.git"
  },
  "bugs": {
    "url": "https://github.com/T1113047/Stronghold-Protocol-Hunt-Simulation/issues"
  },
  "keywords": [
    "arknights",
    "auto-chess",
    "tower-defense",
    "co-op",
    "browser-game",
    "fan-game"
  ],
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node --test \"test/**/*.test.js\" \"test/e2e/coop.e2e.mjs\" \"plugins/_template/**/*.test.js\"",
    "golden": "node tools/golden.mjs",
    "golden:update": "node tools/golden.mjs --update",
    "vendor": "node tools/vendor.mjs",
    "build-data": "node tools/build-data.mjs",
    "assets": "node tools/vendor.mjs && node tools/fetch-assets.mjs",
    "postinstall": "node tools/vendor.mjs",
    "setup": "node tools/setup.mjs",
    "doctor": "node tools/doctor.mjs",
    "launch": "node scripts/launch.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit --checkJs -p jsconfig.json",
    "check:imports": "node tools/check-imports.mjs",
    "ci": "node tools/ci.mjs",
    "package": "node tools/package.mjs",
    "package:lite": "node tools/package.mjs --lite"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "htm": "^3.1.1",
    "pixi-spine": "^4.0.6",
    "pixi.js": "^7.4.2",
    "preact": "^10.29.8",
    "ses": "2.3.0",
    "three": "^0.186.1",
    "ws": "^8.22.0",
    "acorn": "8.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "puppeteer-core": "^25.12.0",
    "typescript": "^5.9.2"
  }
}
